# Cesium Ion Access Token (Get one from https://ion.cesium.com/tokens)
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_ACCESS_TOKEN

# ESA Sentinel-1 SAR Endpoint & API Key (Leave empty if not connected)
VITE_SENTINEL1_ENDPOINT=
VITE_SENTINEL1_API_KEY=

# ESA Sentinel-2 Optical Endpoint & API Key (Leave empty if not connected)
VITE_SENTINEL2_ENDPOINT=
VITE_SENTINEL2_API_KEY=

# Copernicus Marine Service Endpoint & API Key (Leave empty if not connected)
VITE_COPERNICUS_MARINE_ENDPOINT=
VITE_COPERNICUS_MARINE_KEY=
