# VesselAPI (https://vesselapi.com) free-tier API key, used by
# boreas_core/vessels/live_lookup.py for terrestrial-AIS vessel position
# lookups. Free tier: 150 calls/month, no card required.
# https://vesselapi.com/pricing
#
# Optional -- if unset, GET /vessels/roster still works and reports each
# vessel's status as "NOT CONNECTED" with its last known (home port)
# position, rather than failing.
VESSELAPI_API_KEY=

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) OAuth2
# client credentials, for real Sentinel-1/Sentinel-2 quicklook imagery
# (boreas_core/satellite/sentinel_hub.py, via the Sentinel Hub Process API).
# Get these from: register at dataspace.copernicus.eu, then go to the
# Sentinel Hub dashboard's User Settings and create an OAuth client --
# https://documentation.dataspace.copernicus.eu/APIs/SentinelHub/Overview/Authentication.html
# Optional -- if unset, GET /satellite/status reports these tiles as
# "NOT CONNECTED" rather than serving a mismatched fallback image.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copernicus Marine Toolbox (https://data.marine.copernicus.eu) account
# credentials, for the real Antarctic sea-ice-concentration tile
# (boreas_core/satellite/copernicus_marine_fetch.py, OSI-SAF AMSR2 product).
# Just your regular account login -- register for free at
# data.marine.copernicus.eu, no separate "app" credential needed.
#
# NOTE: Copernicus Marine migrated its authentication system in September
# 2026 to a new host (auth.marine.copernicus.eu); these env var names are
# unchanged, and the pinned copernicusmarine>=2.0.0 package handles the new
# host transparently -- no other config needed for that migration.
#
# Optional -- if unset, GET /satellite/status reports this tile as
# "NOT CONNECTED" rather than serving a mismatched fallback image.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
